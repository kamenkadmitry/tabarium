{
  "name": "tabarium",
  "version": "0.1.0",
  "description": "Local-first tab and session manager. No account, no server.",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:e2e": "wxt build --mode e2e",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.13.0",
    "typescript": "latest",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
